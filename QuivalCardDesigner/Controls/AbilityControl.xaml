<UserControl x:Class="QuivalCardDesigner.Controls.AbilityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuivalCardDesigner.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderThickness="1" BorderBrush="LightSeaGreen" Margin="0,0,0,10">
        <Grid Background="WhiteSmoke" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Background="LightSeaGreen" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Label Foreground="WhiteSmoke">Id</Label>
                <Label Foreground="WhiteSmoke">001</Label>
                <Label Foreground="WhiteSmoke" x:Name="EffectLabel"></Label>
                <Button HorizontalAlignment="Right" x:Name="ToggleCollapse" Margin="0,0,0,0" Grid.Column="1" Content="  ▼  " BorderThickness="0" Background="LightSeaGreen" Foreground="WhiteSmoke"></Button>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <local:TargetControl x:Name="TargetControl" Margin="0,0,0,10"></local:TargetControl>
                <local:ValueControl x:Name="ValueControl" Margin="0,0,0,10"></local:ValueControl>
                <local:ConditionalControl x:Name="ConditionalControl" Margin="0,0,0,15"></local:ConditionalControl>

                <StackPanel x:Name="BonusEffectStackPanel" Visibility="Collapsed">
                <Label FontWeight="Bold" >Bonus Effect</Label>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Effect"></Label>
                        <ComboBox x:Name="BonusEffectComboBox" SelectedIndex="0" Width="150" Margin="0,0,10,0"></ComboBox>
                    </StackPanel>

                    <local:ValueControl x:Name="BonusValueControl" Margin="0,0,0,10"></local:ValueControl>
                    <local:ConditionalControl x:Name="BonusConditionalControl" Margin="0,0,0,10"></local:ConditionalControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BonusEffectButton" Content=" Add Bonus Effect " Margin="5,0,0,0"></Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
