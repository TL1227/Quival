<UserControl x:Class="QuivalCardDesigner.Controls.AbilityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuivalCardDesigner.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="WhiteSmoke" Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Background="LightSeaGreen" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Foreground="WhiteSmoke">Id</Label>
            <Label Foreground="WhiteSmoke">001</Label>
            <Label Foreground="WhiteSmoke" x:Name="EffectLabel"></Label>
            <Button HorizontalAlignment="Right" x:Name="ToggleCollapse" Margin="0,0,0,0" Grid.Column="1" Content="  ▼  " BorderThickness="0" Background="LightSeaGreen" Foreground="WhiteSmoke"></Button>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal">
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Label>Target</Label>
                <ComboBox x:Name="TargetTypeComboBox" SelectedIndex="0" Width="150"></ComboBox>
                <Label x:Name="TargetNumberLabel">Choose</Label>
                <ComboBox x:Name="TargetNumberCombobox" SelectedIndex="0">
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                </ComboBox>
                <Label x:Name="TargetPoolLabel">Pool</Label>
                <ComboBox x:Name="TargetPoolComboBox" SelectedIndex="0" Width="100"></ComboBox>
                <Label x:Name="SideLabel">Side</Label>
                <ComboBox x:Name="SideComboBox" SelectedIndex="0" Width="100"></ComboBox>
                <Label x:Name="SelfTargetLabel">Self</Label>
                <CheckBox x:Name="SelfTargetCheckbox" VerticalAlignment="Center"></CheckBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                <Label x:Name="ValueTypeLabel">Value</Label>
                <ComboBox x:Name="ValueTypeComboBox" SelectedIndex="0" Width="80"/>

                <Label x:Name="FixedValueLabel">Amount</Label>
                <ComboBox x:Name="FixedValueComboBox" SelectedIndex="0">
                    <ComboBoxItem>1</ComboBoxItem>
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                </ComboBox>

                <Label x:Name="CountValueSourceLabel">For Each</Label>
                <ComboBox x:Name="CountValueSourceComboBox" SelectedIndex="0"/>

                <Label x:Name="CountSideLabel">Side</Label>
                <ComboBox x:Name="CountSideComboBox" SelectedIndex="0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Grid.Row="0">Conditionals</Label>
                <ComboBox x:Name="ConditionalsComboBox" Width="150" SelectedIndex="0" Margin="0,0,5,0"></ComboBox>
                <Button x:Name="AddConditionalButton" Margin="0,0,0,0" Width="30" HorizontalAlignment="Left">Add</Button>
                <Label x:Name="ConditionalTypeLabel" Grid.Row="0" Visibility="Collapsed">Type</Label>
                <ComboBox x:Name="ConditionalTypeComboBox" Width="150" SelectedIndex="0" Visibility="Collapsed"></ComboBox>
            </StackPanel>
        </StackPanel>
        <ListBox Grid.Row="2" Margin="5" x:Name="ConditionalsListBox" Visibility="Collapsed"/>
    </Grid>
</UserControl>
