<UserControl x:Class="QuivalCardDesigner.Controls.TargetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuivalCardDesigner.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="37" d:DesignWidth="800" d:Background="White"> 
    <StackPanel Orientation="Horizontal">
        <Label>Target</Label>
        <ComboBox x:Name="TargetTypeComboBox" SelectedIndex="0" Width="150"></ComboBox>
        <Label x:Name="TargetNumberLabel">Choose</Label>
        <ComboBox x:Name="TargetNumberCombobox" SelectedIndex="0"/>
        <Label x:Name="TargetPoolLabel">Pool</Label>
        <ComboBox x:Name="TargetPoolComboBox" SelectedIndex="0" Width="100"></ComboBox>
        <Label x:Name="SideLabel">Side</Label>
        <ComboBox x:Name="SideComboBox" SelectedIndex="0" Width="100"></ComboBox>
        <Label x:Name="SelfTargetLabel">Self</Label>
        <CheckBox x:Name="SelfTargetCheckbox" VerticalAlignment="Center"></CheckBox>
    </StackPanel>
</UserControl>
