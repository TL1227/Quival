<Window x:Class="QuivalCardDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuivalCardDesigner"
        mc:Ignorable="d"
        Title="Quival Card Designer" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="NewCardButton"  Content="  New   " BorderThickness="0" Margin="0,0,5,0" Height="Auto" Width="Auto" HorizontalAlignment="Left" Visibility="Collapsed" d:Visibility="Visible"/>
            <Button x:Name="SaveCardButton" Content="  Save  " BorderThickness="0" Margin="0,0,5,0" Height="Auto" Width="Auto" HorizontalAlignment="Left" Visibility="Collapsed" d:Visibility="Visible"/>
            <Button x:Name="LoadCardButton" Content="  Load  " BorderThickness="0" Margin="0,0,5,0" Height="Auto" Width="Auto" HorizontalAlignment="Left" Visibility="Collapsed" d:Visibility="Visible"/>
            <Button x:Name="MenuButton"     Content="  Menu  " BorderThickness="0" Margin="0,0,5,0" Height="Auto" Width="Auto" HorizontalAlignment="Left" Visibility="Collapsed" d:Visibility="Visible"/>
        </StackPanel>
        <ContentControl Grid.Row="1" x:Name="CurrentView"></ContentControl>
    </Grid>
</Window>
