<Window x:Class="QuivalCardDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuivalCardDesigner"
        mc:Ignorable="d"
        Title="Quival Card Designer" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="BackButton" Grid.Row="0" Content="  Back  " Height="20" Width="Auto" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <ContentControl Grid.Row="1" x:Name="CurrentView"></ContentControl>
    </Grid>
</Window>
