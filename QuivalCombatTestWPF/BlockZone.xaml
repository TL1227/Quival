<UserControl x:Class="QuivalCombatTestWPF.BlockZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuivalCombatTestWPF"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="280" 
             Height="150" Width="280" 
             ClipToBounds="False">

    <Grid ClipToBounds="False">
        <Label x:Name="BlockZoneLabel" HorizontalContentAlignment="Center" FontSize="100" Foreground="CornflowerBlue">⛊</Label>
        <Border x:Name="Overlay" Grid.Column="1" Background="Transparent" Panel.ZIndex="999"> </Border>
    </Grid>
</UserControl>
